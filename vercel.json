{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/inject-analytics.js",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/recurring-cleaning.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/recurring-cleaning",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/our-work",
      "destination": "/our-work.html",
      "permanent": true
    },
    {
      "source": "/our-work/",
      "destination": "/our-work.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
